.claude/settings.local.json
.claude/.credentials/
# 메인 워크트리에 worktree 디렉토리 생성하지 않음
.worktrees/

# --- TypeScript / 빌드 캐시 ---
.tsbuildinfo
.turbo/
.swc/
.cache/

